<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>محاكي وحاسبة كفاءة مضخة الكبش الهيدروليكي التفاعلي</title>
    <!-- Google Fonts Cairo and JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 2px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @keyframes ring-glow {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.3); opacity: 0.15; }
        }
        .glow-pulse {
            animation: ring-glow 1.8s infinite ease-in-out;
            transform-origin: center;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased p-0 m-0">

    <div class="max-w-6xl mx-auto px-1 sm:px-4 py-4 sm:py-6">
        
        <!-- MAIN CARD -->
        <div class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden">
            
            <!-- HEADER HERO SECTION -->
            <div class="bg-slate-900 text-white p-5 sm:p-7 border-b border-slate-800">
                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
                    <div class="flex items-center gap-4">
                        <div class="p-3 bg-sky-500/10 rounded-2xl border border-sky-500/20 text-sky-450">
                            <svg class="w-8 h-8 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase font-bold tracking-widest bg-sky-500/20 text-sky-300 px-2.5 py-0.5 rounded-full border border-sky-500/20">منصة محاكاة فيزيائية</span>
                            <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white mt-1">
                                مـحاكي وحاسـبة مـضخة الكبـش الهيدروليـكي
                            </h1>
                            <p class="text-slate-400 text-xs sm:text-sm mt-1 font-normal leading-relaxed">
                                شرح تفاعلي لرفع المياه بالطاقة الذاتية عبر المطرقة المائية الخالية تماماً من الكهرباء والمحروقات.
                            </p>
                        </div>
                    </div>

                    <!-- Dynamic Live Status Brand Panel -->
                    <div class="flex items-center gap-3 bg-slate-800/80 px-4 py-2.5 rounded-2xl border border-slate-700/50 w-full md:w-auto justify-between md:justify-start">
                        <div class="text-right">
                            <div class="text-[9px] text-slate-400 uppercase font-bold tracking-wider">معدل الدقات الحالي</div>
                            <div id="beats-indicator" class="text-sm font-mono font-bold text-sky-400">76 دقة/دقيقة</div>
                        </div>
                        <div class="h-8 w-[1px] bg-slate-700"></div>
                        <div class="text-right">
                            <div class="text-[9px] text-slate-400 uppercase font-bold tracking-wider">الحالة الميكانيكية</div>
                            <div id="valve-indicator" class="text-xs font-bold text-emerald-400 flex items-center gap-1">
                                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                تسارع التدفق
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TABS SYSTEM -->
                <div class="flex border-t border-slate-800 mt-6 gap-2 overflow-x-auto custom-scrollbar pt-3">
                    <button onclick="switchTab('simulation')" id="tab-btn-simulation" class="tab-btn py-2 px-4 font-bold text-xs sm:text-sm flex items-center gap-1.5 border-b-2 border-sky-400 text-sky-400 bg-sky-950/20 rounded-xl transition-all whitespace-nowrap">
                        🚀 المحاكاة الفيزيائية التفاعلية
                    </button>
                    <button onclick="switchTab('calculations')" id="tab-btn-calculations" class="tab-btn py-2 px-4 font-bold text-xs sm:text-sm flex items-center gap-1.5 border-b-2 border-transparent text-slate-400 hover:text-white rounded-xl transition-all whitespace-nowrap">
                        📊 حاسبة الموقع والتحليل
                    </button>
                    <button onclick="switchTab('diy')" id="tab-btn-diy" class="tab-btn py-2 px-4 font-bold text-xs sm:text-sm flex items-center gap-1.5 border-b-2 border-transparent text-slate-400 hover:text-white rounded-xl transition-all whitespace-nowrap">
                        🛠️ كراسة الصنع والتجميع الذاتي (DIY)
                    </button>
                    <button onclick="switchTab('troubleshooting')" id="tab-btn-troubleshooting" class="tab-btn py-2 px-4 font-bold text-xs sm:text-sm flex items-center gap-1.5 border-b-2 border-transparent text-slate-400 hover:text-white rounded-xl transition-all whitespace-nowrap">
                        🔧 دليل إصلاح الصمامات والأعطال
                    </button>
                </div>
            </div>

            <!-- PANEL BOX BODY BACKGROUND -->
            <div class="p-4 sm:p-6 bg-slate-50">

                <!-- TAB 1: INTERACTIVE SIMULATION -->
                <div id="view-simulation" class="tab-content grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                    
                    <!-- Left Column - Simulator and spark monitor -->
                    <div class="lg:col-span-8 flex flex-col gap-5">
                        
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                            
                            <!-- Phase description status banner -->
                            <div class="bg-slate-100/90 px-4 py-3 sm:px-5 flex flex-col sm:flex-row items-center justify-between border-b border-slate-200 gap-3">
                                <div class="flex items-center gap-2">
                                    <span id="phase-badge" class="px-2.5 py-1 bg-sky-100 text-sky-800 font-extrabold rounded-lg text-xs">
                                        المرحلة 1
                                    </span>
                                    <h3 id="phase-title" class="text-xs sm:text-sm font-bold text-slate-850">
                                        تسارع تدفق المياه وانطلاق النبضة
                                    </h3>
                                </div>
                                
                                <div class="flex items-center gap-2">
                                    <button onclick="toggleRunning()" id="play-pause-btn" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-[11px] sm:text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 transition">
                                        إيقاف مؤقت
                                    </button>
                                    <button onclick="forceNextStep()" class="p-1 px-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50 text-[11px] font-semibold flex items-center gap-1">
                                        خطوة &rarr;
                                    </button>
                                    <div class="flex items-center rounded-lg border border-slate-300 overflow-hidden bg-white">
                                        <button onclick="setSpeedMultiplier(0.5)" id="speed-0" class="speed-btn text-[9px] font-bold px-2 py-1 bg-slate-100 text-slate-600 border-l border-slate-200">0.5x</button>
                                        <button onclick="setSpeedMultiplier(1)" id="speed-1" class="speed-btn text-[9px] font-bold px-2 py-1 bg-sky-600 text-white border-l border-slate-200">1x</button>
                                        <button onclick="setSpeedMultiplier(2)" id="speed-2" class="speed-btn text-[9px] font-bold px-2 py-1 bg-slate-100 text-slate-600">2x</button>
                                    </div>
                                </div>
                            </div>

                            <!-- GEOMETRY INTERACTIVE CANVAS SVG -->
                            <div class="relative bg-slate-950 p-2 sm:p-5 overflow-x-auto custom-scrollbar">
                                <div class="min-w-[650px] w-full flex justify-center">
                                    <svg viewBox="0 0 800 450" class="w-full max-w-[800px] h-auto select-none overflow-visible">
                                        <defs>
                                            <linearGradient id="gradientWater" x1="0" y1="0" x2="1" y2="1">
                                                <stop offset="0%" stop-color="#38bdf8" />
                                                <stop offset="100%" stop-color="#0284c7" />
                                            </linearGradient>
                                            <linearGradient id="chamberGlowStatic" x1="0" y1="0" x2="0" y2="1">
                                                <stop offset="0%" stop-color="#e2e8f0" stop-opacity="0.1" />
                                                <stop offset="100%" stop-color="#475569" stop-opacity="0.4" />
                                            </linearGradient>
                                        </defs>

                                        <!-- Ground Background -->
                                        <path d="M 0 350 L 320 380 L 320 450 L 0 450 Z" fill="#334155" opacity="0.15" />
                                        <line x1="0" y1="350" x2="320" y2="380" stroke="#64748b" stroke-width="1.2" stroke-dasharray="3 2" />
                                        <path d="M 500 450 L 500 380 L 640 280 L 800 280 L 800 450 Z" fill="#334155" opacity="0.15" />
                                        <line x1="500" y1="380" x2="640" y2="280" stroke="#64748b" stroke-width="1.2" stroke-dasharray="3 2" />

                                        <!-- Concrete Support Foundation Block -->
                                        <rect x="330" y="380" width="160" height="40" fill="#64748b" rx="4" />
                                        <text x="410" y="405" fill="#f8fafc" font-size="11" text-anchor="middle" font-weight="bold" opacity="0.75">قاعدة تثبيت خرسانية صلبة</text>

                                        <!-- SUPPLY WATER RESERVOIR (أ) -->
                                        <rect x="15" y="80" width="110" height="160" fill="none" stroke="#475569" stroke-width="3" rx="8" />
                                        <rect id="svg-source-water-fill" x="18" y="140" width="104" height="98" fill="url(#gradientWater)" opacity="0.65" rx="5" />
                                        <text x="70" y="60" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">خزان التغذية (أ)</text>

                                        <!-- DRIVE INLET PIPE (ب) -->
                                        <line x1="125" y1="205" x2="340" y2="350" stroke="#64748b" stroke-width="26" stroke-linecap="round" />
                                        <line id="svg-drive-water-beam" x1="125" y1="205" x2="340" y2="350" stroke="#0ea5e9" stroke-width="18" stroke-linecap="round" opacity="0.9" />

                                        <!-- Moving Water Particles -->
                                        <g id="drive-particles" opacity="0.75">
                                            <circle id="bp1" cx="140" cy="216" r="4.5" fill="#f8fafc" />
                                            <circle id="bp2" cx="195" cy="254" r="4" fill="#bae6fd" />
                                            <circle id="bp3" cx="245" cy="287" r="4" fill="#f8fafc" />
                                            <circle id="bp4" cx="300" cy="324" r="4.5" fill="#bae6fd" />
                                        </g>

                                        <!-- CAST BODY -->
                                        <rect x="330" y="335" width="130" height="35" fill="#334155" rx="8" />
                                        <rect x="340" y="343" width="110" height="19" fill="#0284c7" opacity="0.85" />

                                        <!-- CLACK CHAMBER (ج) -->
                                        <rect x="420" y="300" width="30" height="40" fill="#334155" />
                                        <rect x="425" y="304" width="20" height="36" fill="#0ea5e9" opacity="0.85" />
                                        <rect x="410" y="290" width="50" height="10" fill="#eab308" rx="2" />

                                        <!-- Waste Valve Plunger Arm & Brass Weight -->
                                        <g id="svg-waste-plunger">
                                            <rect x="419" y="274" width="32" height="10" fill="#854d0e" rx="1.5" />
                                            <line x1="435" y1="262" x2="435" y2="274" stroke="#ca8a04" stroke-width="5.5" />
                                            <circle cx="435" cy="254" r="7.5" fill="#ef4444" />
                                        </g>

                                        <!-- Water spilling spray effect -->
                                        <path id="svg-water-spray" d="M 412 284 C 390 270 380 278 372 285 M 458 284 C 475 270 488 275 496 285" stroke="#38bdf8" stroke-width="4.5" fill="none" stroke-linecap="round" opacity="0" />

                                        <!-- CHECK VALVE (د) -->
                                        <rect x="355" y="300" width="30" height="40" fill="#334155" />
                                        <rect x="360" y="304" width="20" height="36" fill="#0284c7" opacity="0.9" />
                                        <line id="svg-check-gate" x1="360" y1="310" x2="380" y2="310" stroke="#ef4444" stroke-width="5" stroke-linecap="round" />

                                        <!-- Wave Shocks ring -->
                                        <g id="svg-hammer-spark" fill="none" stroke="#f43f5e" stroke-width="3" opacity="0">
                                            <circle cx="435" cy="290" r="14" />
                                            <circle cx="435" cy="290" r="26" opacity="0.5" />
                                        </g>

                                        <!-- PRESSURE DOME (هـ) -->
                                        <path d="M 335 240 Q 335 150 370 150 Q 405 150 405 240 L 405 305 L 335 305 Z" fill="url(#chamberGlowStatic)" />
                                        <rect id="svg-chamber-water-level" x="337" y="235" width="66" height="70" fill="#0284c7" opacity="0.75" />
                                        <!-- Air Pocket bubble -->
                                        <path d="M 337 235 Q 335 152 370 152 Q 403 152 403 235 Z" fill="#ffedd5" opacity="0.4" stroke="#fed7aa" stroke-width="1.2" stroke-dasharray="3 2" />
                                        <text x="370" y="195" fill="#f97316" font-size="9.5" font-weight="extrabold" text-anchor="middle">هواء محبوس</text>

                                        <path d="M 335 250 L 335 305 M 405 250 L 405 305" stroke="#94a3b8" stroke-width="3" />
                                        <path d="M 335 250 Q 335 150 370 150 Q 405 150 405 250" stroke="#94a3b8" stroke-width="3" fill="none" />

                                        <!-- DISCHARGE PIPE (و) -->
                                        <path d="M 405 285 L 430 285 L 430 350 L 680 350 L 680 100 L 710 100" fill="none" stroke="#475569" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M 405 285 L 430 285 L 430 350 L 680 350 L 680 100 L 710 100" fill="none" stroke="#0ea5e9" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
                                        <path id="svg-delivery-dash-flow" d="M 405 285 L 430 285 L 430 350 L 680 350 L 680 100 L 710 100" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-dasharray="8 20" />

                                        <!-- OVERHEAD HARVEST TANK (ز) -->
                                        <rect x="710" y="50" width="75" height="90" fill="none" stroke="#475569" stroke-width="3" rx="6" />
                                        <rect id="svg-target-water-fill" x="713" y="100" width="69" height="38" fill="url(#gradientWater)" opacity="0.65" rx="4" />
                                        <text x="748" y="38" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">خزان الهدف (ز)</text>

                                        <!-- Water spill trickle inside destination-->
                                        <path id="svg-water-trickle" d="M 710 100 Q 722 100 726 112 T 728 135" stroke="#38bdf8" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.8" />

                                        <!-- Measurement dimension lines -->
                                        <line x1="12" y1="238" x2="160" y2="238" stroke="#10b981" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
                                        <line x1="12" y1="140" x2="12" y2="238" stroke="#10b981" stroke-width="1.2" />
                                        <polygon points="12,137 8,144 16,144" fill="#10b981" />
                                        <polygon points="12,241 8,234 16,234" fill="#10b981" />
                                        <text id="lbl-H-val" x="22" y="195" fill="#10b981" font-size="10.5" font-weight="bold">H = 2.5m</text>

                                        <line x1="660" y1="350" x2="795" y2="350" stroke="#f43f5e" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
                                        <line x1="660" y1="100" x2="795" y2="100" stroke="#f43f5e" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
                                        <line x1="790" y1="100" x2="790" y2="350" stroke="#f43f5e" stroke-width="1.2" />
                                        <polygon points="790,97 786,104 794,104" fill="#f43f5e" />
                                        <polygon points="790,353 786,346 794,346" fill="#f43f5e" />
                                        <text id="lbl-h-val" x="735" y="235" fill="#f43f5e" font-size="10.5" font-weight="bold">h = 15m</text>

                                        <!-- HOTSPOTS -->
                                        <g class="cursor-pointer" onclick="selectComponent('source_tank')">
                                            <circle id="pin-source_tank" cx="70" cy="160" r="14" fill="#1e293b" stroke="#ffffff" stroke-width="2" />
                                            <text x="70" y="164" fill="#ffffff" font-size="11" text-anchor="middle" font-weight="bold">أ</text>
                                        </g>
                                        <g class="cursor-pointer" onclick="selectComponent('drive_pipe')">
                                            <circle id="pin-drive_pipe" cx="210" cy="265" r="14" fill="#1e293b" stroke="#ffffff" stroke-width="2" />
                                            <text x="210" y="269" fill="#ffffff" font-size="11" text-anchor="middle" font-weight="bold">ب</text>
                                        </g>
                                        <g class="cursor-pointer" onclick="selectComponent('waste_valve')">
                                            <circle id="pin-waste_valve" cx="482" cy="305" r="14" fill="#0ea5e9" stroke="#ffffff" stroke-width="2" class="glow-pulse" />
                                            <text x="482" y="309" fill="#ffffff" font-size="11" text-anchor="middle" font-weight="bold">ج</text>
                                        </g>
                                        <g class="cursor-pointer" onclick="selectComponent('check_valve')">
                                            <circle id="pin-check_valve" cx="315" cy="300" r="14" fill="#1e293b" stroke="#ffffff" stroke-width="2" />
                                            <text x="315" y="304" fill="#ffffff" font-size="11" text-anchor="middle" font-weight="bold">د</text>
                                        </g>
                                        <g class="cursor-pointer" onclick="selectComponent('air_chamber')">
                                            <circle id="pin-air_chamber" cx="370" cy="115" r="14" fill="#1e293b" stroke="#ffffff" stroke-width="2" />
                                            <text x="370" y="119" fill="#ffffff" font-size="11" text-anchor="middle" font-weight="bold">هـ</text>
                                        </g>
                                        <g class="cursor-pointer" onclick="selectComponent('delivery_pipe')">
                                            <circle id="pin-delivery_pipe" cx="580" cy="350" r="14" fill="#1e293b" stroke="#ffffff" stroke-width="2" />
                                            <text x="580" y="354" fill="#ffffff" font-size="11" text-anchor="middle" font-weight="bold">و</text>
                                        </g>
                                        <g class="cursor-pointer" onclick="selectComponent('delivery_tank')">
                                            <circle id="pin-delivery_tank" cx="745" cy="165" r="14" fill="#1e293b" stroke="#ffffff" stroke-width="2" />
                                            <text x="745" y="169" fill="#ffffff" font-size="11" text-anchor="middle" font-weight="bold">ز</text>
                                        </g>
                                    </svg>
                                </div>
                                <div class="absolute bottom-3 right-3 text-[10px] text-slate-400 bg-slate-950/70 py-1.5 px-3 rounded-xl border border-slate-700/50 backdrop-blur-sm">
                                    💡 انقر فوق الأحرف الإقليدية (أ، ب، ج...) لقراءة أدوار الأجزاء ونوع خامات الصنع.
                                </div>
                            </div>

                            <!-- PERIODIC PHASES BAR -->
                            <div class="p-4 bg-slate-50 border-t border-b border-slate-200">
                                <h4 class="text-xs font-bold text-slate-700 mb-2.5 flex items-center gap-1.5 font-sans">
                                    <span class="h-2 w-2 rounded-full bg-sky-500 animate-ping"></span>
                                    مخطط الدورة الميكانيكية الزمنية التلقائية:
                                </h4>
                                <div class="grid grid-cols-4 gap-2 text-center text-[11px]">
                                    <div onclick="forcePhase(0)" id="phase-idx-0" class="p-2.5 rounded-xl border bg-sky-600 border-sky-700 text-white font-bold cursor-pointer transition">
                                        <div>المرحلة 1</div>
                                        <div class="truncate">تسارع التدفق</div>
                                    </div>
                                    <div onclick="forcePhase(1)" id="phase-idx-1" class="p-2.5 rounded-xl border bg-white border-slate-200 text-slate-600 hover:border-slate-300 cursor-pointer transition">
                                        <div>المرحلة 2</div>
                                        <div class="truncate">المطرقة المائية</div>
                                    </div>
                                    <div onclick="forcePhase(2)" id="phase-idx-2" class="p-2.5 rounded-xl border bg-white border-slate-200 text-slate-600 hover:border-slate-300 cursor-pointer transition">
                                        <div>المرحلة 3</div>
                                        <div class="truncate">دخول الماء والضخ</div>
                                    </div>
                                    <div onclick="forcePhase(3)" id="phase-idx-3" class="p-2.5 rounded-xl border bg-white border-slate-200 text-slate-600 hover:border-slate-300 cursor-pointer transition">
                                        <div>المرحلة 4</div>
                                        <div class="truncate">الارتداد والتكرار</div>
                                    </div>
                                </div>
                            </div>

                            <!-- REALTIME STATS METERS -->
                            <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-x sm:divide-x-reverse sm:divide-y-0 divide-slate-100 bg-white">
                                <div class="p-4 flex items-center justify-between">
                                    <div>
                                        <div class="text-[10px] text-slate-400 uppercase font-bold">المقدار الصافي المرفوع</div>
                                        <div id="metric-pumped" class="text-xl font-bold font-mono text-emerald-600 mt-0.5">0.000 لتر</div>
                                    </div>
                                    <span class="text-2xl bg-emerald-50 p-2 rounded-xl text-emerald-600">🚰</span>
                                </div>
                                <div class="p-4 flex items-center justify-between">
                                    <div>
                                        <div class="text-[10px] text-slate-400 uppercase font-bold">المقدار المهدور للتصريف</div>
                                        <div id="metric-wasted" class="text-xl font-bold font-mono text-slate-600 mt-0.5">0.000 لتر</div>
                                    </div>
                                    <span class="text-2xl bg-slate-50 p-2 rounded-xl text-slate-500">💧</span>
                                </div>
                                <div class="p-4 flex items-center justify-between">
                                    <div>
                                        <div class="text-[10px] text-slate-400 uppercase font-bold">عدد النبضات الإجمالية</div>
                                        <div id="metric-beats" class="text-xl font-bold font-mono text-sky-600 mt-0.5">0 دقة</div>
                                    </div>
                                    <button onclick="resetOdometer()" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-lg text-xs font-semibold transition">
                                        🔄 تصفير
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- GRAPH PRESSURE PANEL -->

                                    <path id="chart-spark-path" d="M0,75 L500,75" fill="none" stroke="#f43f5e" stroke-width="2.5" />
                                </svg>
                                <div class="absolute inset-0 border-t border-b border-rose-500/10 pointer-events-none"></div>
                                <div class="absolute bottom-[25px] w-full border-t border-dashed border-rose-500/25 text-[8px] text-rose-400 px-2 pointer-events-none">الضغط الساكن للمنبع الرئيسي</div>
                            </div>
                        </div>

                    </div>

                    <!-- Right Column - Parameters Control -->
                    <div class="lg:col-span-4 flex flex-col gap-6">
                        
                        <!-- SLIDERS CONTROLS -->
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                            <h4 class="text-sm font-extrabold text-slate-800 mb-4 flex items-center gap-1.5 font-sans">
                                ⚙️ موائم بارامترات الموقع والأنابيب
                            </h4>

                            <div class="space-y-4">
                                <!-- H Slider -->
                                <div>
                                    <div class="flex justify-between text-xs mb-1">
                                        <span class="text-slate-700 font-bold">ارتفاع مياه المصدر المتوفر (H)</span>
                                        <span id="slide-lbl-H" class="font-mono font-bold text-emerald-600">2.5 متر</span>
                                    </div>
                                    <input id="slider-H" type="range" min="1" max="8" step="0.5" value="2.5" oninput="runCalculationsAndUpdate()" class="w-full accent-emerald-500 h-1.5 bg-slate-100 rounded-lg cursor-pointer" />
                                    <p class="text-[9px] text-slate-400 mt-1">الارتفاع العمودي من الخلية المائية الأعلى إلى المضخة.</p>
                                </div>

                                <!-- h Slider -->
                                <div>
                                    <div class="flex justify-between text-xs mb-1">
                                        <span class="text-slate-700 font-bold">ارتفاع خزان الضخ المطلوب (h)</span>
                                        <span id="slide-lbl-h" class="font-mono font-bold text-rose-500">15 متر</span>
                                    </div>
                                    <input id="slider-h" type="range" min="5" max="45" step="1" value="15" oninput="runCalculationsAndUpdate()" class="w-full accent-rose-500 h-1.5 bg-slate-100 rounded-lg cursor-pointer" />
                                    <p class="text-[9px] text-slate-400 mt-1">المسافة العمودية الصافية للبلدة أو خزان أعلى المحاصيل.</p>
                                </div>

